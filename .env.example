# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored and must never be committed.
#
# These are only needed to run the realtime engine (realtime_chat.py /
# fast_brain.py). The orchestration core needs no keys at all.

# --- Fast brain (LLM) ---
# doubao ARK key (https://www.volcengine.com/product/doubao)
ARK_API_KEY_FAST=
# Alibaba DashScope key (optional fallback model)
DASHSCOPE_API_KEY=

# --- doubao SC2.0 realtime dialog credentials ---
# App ID / Access Key for the end-to-end realtime voice model.
# Passed into realtime_chat.init(app_id, access_key) by your launcher.
VOLC_DIALOG_APP_ID=
VOLC_DIALOG_ACCESS_KEY=

# --- Optional: realtime built-in web search ---
VOLC_WEBSEARCH_API_KEY=
VOLC_WEBSEARCH_BOT_ID=

# --- Optional cloned voices used by the public voice_registry adapter ---
# Keep real voice ids in your local .env only.
CHARACTER_A_VOICE_ID=
CHARACTER_A_VOICE_MODEL=cosyvoice-v3-plus
CHARACTER_B_VOICE_ID=
CHARACTER_B_VOICE_MODEL=cosyvoice-v3-plus

# --- Local deployment layer (my_show.py / show_settings.py) ---
# The web stage and settings panel read these; in the browser they can also be
# set from the gear icon, which writes show_settings.json and takes effect
# without a restart. API keys stay in that gitignored file.

# Any OpenAI-compatible endpoint for the fast brain (LLM). When set, it becomes
# the default model and no ARK / DashScope key is needed.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Which independent TTS vendor to use on the text architecture: mimo | cosyvoice
TTS_PROVIDER=mimo

# MiMo TTS (https://mimo.mi.com) — preset voices, cloning, streaming PCM out.
MIMO_TTS_BASE_URL=
MIMO_TTS_API_KEY=
# Set to 1 to trace stream open/close, chunk counts and playback stalls.
MIMO_TTS_DEBUG=
